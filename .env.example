# Offload environment variables.
# Copy this file to .env.local for local development (.env.local is git-ignored):
#   cp .env.example .env.local
# On Vercel, set the same names under Project → Settings → Environment Variables.

# ── Google OAuth client ──────────────────────────────────────────────
# A "Web application" client in Google Cloud → APIs & Services → Credentials.
# The web app (/app) uses the ID in the browser; the MCP connector uses both.
# The client needs:
#   Authorised JavaScript origins: http://localhost:3000 (and your production site)
#   Authorised redirect URIs:      http://localhost:3000/oauth/callback (and https://YOUR-SITE/oauth/callback)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── MCP connector ────────────────────────────────────────────────────
# Seals the connector's tokens with AES-256-GCM. At least 32 random characters.
# Generate one with:  openssl rand -base64 48
# Changing it signs every connector connection out.
MCP_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Optional. The site's public address, if requests reach it under another host name
# (e.g. behind a proxy). Leave empty to derive it from the request.
MCP_PUBLIC_URL=

# ── Site ─────────────────────────────────────────────────────────────
# Public address used for canonical links, the sitemap, share previews and llms.txt.
# Read at build time, so rebuild/redeploy after changing it.
# Production: https://www.offloadapp.space
# If empty, Vercel's production address is used, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── IndexNow (scripts/indexnow.mjs) ──────────────────────────────────
# The ping runs only on Vercel production builds (VERCEL_ENV=production, set by Vercel).
# Set to 1 to force it on a non-production build.
INDEXNOW=
